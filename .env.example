# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...

# LLM
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Retrieval
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_TARGET_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_TOP_K=5
# At most this many chunks from any single document, so multi-document questions see both sources.
RETRIEVAL_MAX_CHUNKS_PER_DOC=3
# Refusal gate: refuse (without calling the LLM) only when BOTH are below threshold.
# Calibrated with eval/retrieval_probe.py (best score over the 4x top_k candidate pool):
# relevant queries scored dense>=0.379 / bm25>=6.3, irrelevant ones dense<=0.354 / bm25<=4.2.
# The dense margin is thin (0.025); the LLM layer is the backstop when the gate lets a
# borderline query through.
RETRIEVAL_MIN_DENSE_SCORE=0.37
RETRIEVAL_MIN_BM25_SCORE=5.0
RRF_K=60
# Set to 1 for air-gapped deployments once the embedding model is in the local HF cache.
# HF_HUB_OFFLINE=1
RETRIEVAL_CONTEXT_TOKEN_BUDGET=1800

# Document anchoring: a query naming a patient / member id / policy number pulls that document in whole.
RETRIEVAL_ENABLE_DOCUMENT_ANCHORING=true
RETRIEVAL_ANCHOR_DOC_TOKEN_BUDGET=900
RETRIEVAL_MAX_ANCHORED_DOCS=2

# Guardrails
MAX_QUERY_CHARS=2000
# flag = add a warning when the query holds SSN/phone/DOB/email patterns (mock data); block = refuse (real data)
PHI_POLICY=flag
# Confidence composite: retrieval strength saturates at these scores; band cut-offs
RETRIEVAL_STRONG_DENSE_SCORE=0.65
RETRIEVAL_STRONG_BM25_SCORE=15.0
CONFIDENCE_HIGH=0.80
CONFIDENCE_MEDIUM=0.55

# Service
LLM_MAX_CONCURRENCY=8
ANSWER_CACHE_SIZE=256

# Agent loop
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_SECONDS=5
MAX_REPAIR_ATTEMPTS=2
PROMPT_VERSION=v4
# Set to "bad_citation" or "malformed_json" to demonstrate the repair path in a live run.
FAULT_INJECTION=

# Observability / PHI hygiene
LOG_LEVEL=INFO
LOG_CHUNK_TEXT=false
